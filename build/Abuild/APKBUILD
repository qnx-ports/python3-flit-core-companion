cee12b7275f8d1e2dc989d79b44d86fcd714bd5166a197d455b40d8c74c2eec66dfa204e1759e90fd9d5ae9b50e91d68648ee5e3223dc01dde79eeab411bfcb1  vendor-licenses.patch
"
